{
  "opencollection": "1.0.0",
  "info": {
    "name": "Drone CI REST Builds Secrets API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List secrets for a repository",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://drone.example.com/api/repos/:owner/:repo/secrets",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "repo",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List secrets for a repository"
        },
        {
          "info": {
            "name": "Create a secret for a repository",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://drone.example.com/api/repos/:owner/:repo/secrets",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "repo",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create a secret for a repository"
        }
      ]
    }
  ],
  "bundled": true
}