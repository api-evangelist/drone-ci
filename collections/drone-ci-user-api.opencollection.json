{
  "opencollection": "1.0.0",
  "info": {
    "name": "Drone CI REST Builds User API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the authenticated user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://drone.example.com/api/user"
          },
          "docs": "Get the authenticated user"
        }
      ]
    }
  ],
  "bundled": true
}