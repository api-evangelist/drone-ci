    },
    {
      "info": {
        "name": "Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List pipeline templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://drone.example.com/api/templates"
