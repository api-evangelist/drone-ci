          "http": {
            "method": "POST",
            "url": "https://drone.example.com/api/repos/:owner/:repo/cron",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "repo",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create a cron job for a repository"
